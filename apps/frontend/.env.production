# Продакшн-конфіг фронтенду (build-time, вбудовується у бандл — НЕ секрет).
# VITE_API_URL = URL бекенду на Render. За замовчуванням — ім'я сервісу з
# render.yaml (car-calculator-api). Якщо назвеш сервіс інакше — або онови тут,
# або (краще) задай VITE_API_URL у змінних проєкту на Vercel: значення з
# середовища Vercel має пріоритет над цим файлом.
VITE_API_URL="https://car-calculator-api.onrender.com"
