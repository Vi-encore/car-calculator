# Цей файл комітити в git. Справжні значення — тільки в .env (НЕ комітити!)

# Environment: local | test | dev | stage | prod
APP_ENV="local"

# База даних (PostgreSQL)
DATABASE_URL="postgresql://postgres:secret@localhost:5432/car_calculator?schema=public"

# JWT секрети (мінімум 32 символи кожен)
# Генерація: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret"

# Сервер
PORT=3000
NODE_ENV="development"

# CORS — дозволений origin фронтенду (використовується в enableCors)
# local:  http://localhost:5173
# stage:  https://staging.car-calculator.com
# prod:   https://car-calculator.com
FRONTEND_URL="http://localhost:5173"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary — завантаження аватарок (ОБОВ'ЯЗКОВО, інакше бекенд не стартує)
# Значення беруться з дашборду https://cloudinary.com (Account Details)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Ціни на авто: mock (за замовчуванням) або autoria (реальні дані AUTO.RIA)
PRICES_PROVIDER="mock"
# Ключ обов'язковий лише коли PRICES_PROVIDER=autoria (developers.ria.com)
# AUTO_RIA_API_KEY="your-auto-ria-key"
# Скільки карток авто збагачувати через /auto/info (= стільки info-запитів)
AUTO_RIA_SAMPLE_SIZE=10
# Власний бюджет запитів, нижче лімітів free-тарифу (30/год, 1000/міс)
AUTO_RIA_HOURLY_BUDGET=25
AUTO_RIA_MONTHLY_BUDGET=900
# Скільки годин переюзати кешований розрахунок (168 = 7 днів)
AUTO_RIA_CACHE_TTL_HOURS=168

# Google OAuth2 (ОБОВ'ЯЗКОВО — бекенд не стартує без цих значень)
# Створити OAuth-клієнт (Web) у Google Cloud Console:
#   Authorized redirect URI = значення GOOGLE_CALLBACK_URL нижче
#   Authorized JS origin     = FRONTEND_URL
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Пошта — Gmail SMTP для кодів скидання пароля (ОБОВ'ЯЗКОВО)
# MAIL_PASSWORD — це App Password (16 символів), НЕ звичайний пароль.
# Потрібна увімкнена 2FA: https://myaccount.google.com/apppasswords
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USER="your-gmail@gmail.com"
MAIL_PASSWORD="your-16-char-app-password"
MAIL_FROM="CarCalculator <your-gmail@gmail.com>"

# Скидання пароля: час життя коду (хв) і макс. спроб на код
PASSWORD_RESET_CODE_TTL_MIN=10
PASSWORD_RESET_MAX_ATTEMPTS=5
