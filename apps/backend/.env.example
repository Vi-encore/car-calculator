# Цей файл комітити в git. Справжні значення — тільки в .env (НЕ комітити!)

# Environment: local | test | dev | stage | prod
APP_ENV="local"

# База даних (PostgreSQL)
DATABASE_URL="postgresql://postgres:secret@localhost:5432/car_calculator?schema=public"

# JWT секрети (мінімум 32 символи кожен)
# Генерація: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret"

# Сервер
PORT=3000
NODE_ENV="development"

# CORS — дозволений origin фронтенду (використовується в enableCors)
# local:  http://localhost:5173
# stage:  https://staging.car-calculator.com
# prod:   https://car-calculator.com
FRONTEND_URL="http://localhost:5173"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth2 (необов'язково для початку)
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
