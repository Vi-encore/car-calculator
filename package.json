{
  "name": "car-calculator",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f apps/backend/docker-compose.yml up -d && turbo run dev",
    "db:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "db:down": "docker compose -f apps/backend/docker-compose.yml down",
    "db:studio": "npm run --workspace=apps/backend db:check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
