# Normalize line endings: text files are stored as LF in the repo and
# checked out as LF, so Windows CRLF no longer trips prettier/eslint.
* text=auto eol=lf

# Binary assets — never touch their bytes
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary
