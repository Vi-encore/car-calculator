{
  "family": "car-calc-frontend",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::703697786238:role/focc-ecs-task-execution-matiushko",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "703697786238.dkr.ecr.us-east-1.amazonaws.com/car-calc-frontend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp", "appProtocol": "http" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/car-calc-frontend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
